# =====================================
*~
*.swp
*.swo
*.bak
.vscode/
.idea/

# =====================================
# Vivado 日志、缓存和生成目录
# =====================================
*.jou
*.log
*.str
*.wdb
*.wcfg
*.vcd

.Xil/
**/.Xil/

*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/

# Vivado 报告和中间结果
*.rpt
*.pb
*.dcp

# =====================================
# Vitis / SDK 工作区缓存
# =====================================
.metadata/
**/.metadata/
RemoteSystemsTempFiles/

# 常见编译输出目录
Debug/
Release/

# C / C++ 编译中间文件
*.o
*.obj
*.a
*.d
*.elf
*.map

# =====================================
# FPGA / 启动镜像生成结果
# 验证通过的发布文件建议放 GitHub Releases
# =====================================
*.bit
*.bin
*.mcs

# =====================================
# Python 辅助脚本缓存
# =====================================
__pycache__/
*.pyc
.venv/
venv/

# =====================================
# 如果以后使用 Node 工具
# =====================================
node_modules/
