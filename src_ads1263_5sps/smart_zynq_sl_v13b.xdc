# Verified against SmartZynq_SL_Schematic_V1d3B_20260415.pdf, pages 2,6,7,9.
# J5 mapping is for V1.2/V1.3/V1.3B ONLY. F17 G17 E18 F18 H19 H20 unused.
set_property PACKAGE_PIN M19 [get_ports clk_50m]
set_property IOSTANDARD LVCMOS33 [get_ports clk_50m]
create_clock -name sys_clk -period 20.000 [get_ports clk_50m]

# Core J5 pin -> FPGA ball -> ADS1263 module P2 pin.
set_property PACKAGE_PIN F16 [get_ports adc_sclk]    ;# J5.38 -> P2.8  SCLK_M
set_property PACKAGE_PIN E16 [get_ports adc_mosi]    ;# J5.37 -> P2.7  DIN_M
set_property PACKAGE_PIN C19 [get_ports adc_miso]    ;# J5.36 -> P2.9  DOUT_M
set_property PACKAGE_PIN D18 [get_ports adc_cs_n]    ;# J5.35 -> P2.6  CSN_M
set_property PACKAGE_PIN E15 [get_ports adc_drdy_n]  ;# J5.34 -> P2.10 DRDYN_M
set_property PACKAGE_PIN D15 [get_ports adc_reset_n] ;# J5.33 -> P2.12 RESETN_M
set_property PACKAGE_PIN D16 [get_ports adc_start]   ;# J5.32 -> P2.5  START_M

# Onboard peripherals: PL UART TX -> CH340N RX -> USB-C P1, KEY2 and LEDs.
set_property PACKAGE_PIN L17 [get_ports uart_tx_o]
set_property PACKAGE_PIN J20 [get_ports key_reset_n]
set_property PACKAGE_PIN P20 [get_ports led_ready]
set_property PACKAGE_PIN P21 [get_ports led_error]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_* uart_tx_o key_reset_n led_*}]
set_property DRIVE 8 [get_ports {adc_cs_n adc_sclk adc_mosi adc_reset_n adc_start uart_tx_o led_*}]
set_property SLEW SLOW [get_ports {adc_cs_n adc_sclk adc_mosi adc_reset_n adc_start uart_tx_o led_*}]
# Prevent floating inputs while module is absent. External pull-up alone is not a
# substitute for the register-ID/configuration checks in the reader.
set_property PULLUP TRUE [get_ports {adc_drdy_n adc_miso key_reset_n}]

# SCLK is a GPIO generated by a 50 MHz clock-enable FSM, not an internal clock.
# MISO changes at SCLK rising; sampled 10 us later at default 50 kHz
# (500 ns at optional 1 MHz). Two system
# clock synchronizer stages add ~40..60 ns. PCB/cable plus DOUT delay must fit
# this margin. Keep wires short (<20 cm recommended) and ground alongside SPI.
# Cut ONLY asynchronous input -> first synchronizer stage, never all SPI logic.
set_false_path -from [get_ports adc_miso] -to [get_pins -of_objects [get_cells -hier -regexp {.*miso_sync_reg\[0\]}] -filter {REF_PIN_NAME == D}]
set_false_path -from [get_ports adc_drdy_n] -to [get_pins -of_objects [get_cells -hier -regexp {.*drdy_sync_reg\[0\]}] -filter {REF_PIN_NAME == D}]
set_false_path -from [get_ports key_reset_n] -to [get_pins -of_objects [get_cells -hier -regexp {.*key_sync_reg\[0\]}] -filter {REF_PIN_NAME == D}]
# GPIO output registers must reach package outputs within one 20 ns system cycle.
# Peripheral setup/hold/CS spacing use 10 us intervals (500 ns at 1 MHz);
# these are not falsely modeled as data synchronous to the ADC internal clock.
set_max_delay -datapath_only 20.000 -from [all_registers] -to [get_ports {adc_cs_n adc_sclk adc_mosi adc_reset_n adc_start uart_tx_o led_*}]
